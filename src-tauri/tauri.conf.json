{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stikies",
  "version": "0.1.1",
  "identifier": "com.stikies.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Stikies",
    "shortDescription": "트레이에 머무는 가벼운 스티키 노트",
    "longDescription": "텍스트와 이미지를 붙여 넣는 트레이 스티키 노트. 노트는 지정한 폴더의 Parquet 파일로 저장됩니다.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Korean"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
